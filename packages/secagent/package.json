{
	"name": "@earendil-works/pi-secagent",
	"version": "0.84.2",
	"description": "Cybersecurity profile, policy runtime, evidence model, and reporting for Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./profile": {
			"types": "./dist/profile.d.ts",
			"import": "./dist/profile.js"
		}
	},
	"files": [
		"dist",
		"agents",
		"templates",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx cp -r agents templates dist/",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.2",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@types/node": "24.12.4",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"keywords": ["cybersecurity", "security-agent", "pi", "agent"],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"piSecAgent": {
		"runtimePackages": [
			"npm:pi-sandbox@0.6.3",
			"npm:pi-mcp-adapter@2.23.0",
			"npm:pi-subagents@0.50.0",
			"npm:pi-trace-extension@0.1.14"
		]
	},
	"pi-subagents": {
		"agents": ["./agents"]
	}
}
